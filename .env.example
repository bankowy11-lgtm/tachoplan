# Skopiuj ten plik do `.env` i uzupełnij wartości. `.env` NIE jest wersjonowany
# (patrz .gitignore) i NIE jest nigdy dołączany do bundla front-endowego —
# zmienne bez prefiksu VITE_ są dostępne tylko po stronie serwera
# (`vite.config.ts` dev middleware / `api/directions.ts` na produkcji).
#
# Token prywatny (sekretny) Mapbox — używany WYŁĄCZNIE po stronie serwera,
# żeby wyznaczać trasy (Directions API). Nigdy nie umieszczaj go w kodzie
# front-endowym ani w zmiennej z prefiksem VITE_.
MAPBOX_TOKEN=

# Miejsce na przyszły klucz Google Maps (gdy powstanie api/directions-google.ts) —
# również tylko po stronie serwera.
GOOGLE_MAPS_API_KEY=
